# Artefatos de verificação / dev (não são fonte)
shots/
.playwright-mcp/
*.log
server.log
incl.js

# Dependências / build
node_modules/
dist/
# saída do build de PACOTE (`npm run build:pkg`, tsconfig.pkg.json) — é o que o `exports` aponta e o que o
# `npm publish` embarca. Gerado, nunca versionado, pela mesma razão que o `dist/`.
dist-pkg/
.vite/
*.tsbuildinfo

# Sistema operacional
.DS_Store
Thumbs.db

# Referências PixelLab (design only; licença != GPL — não embutir no jogo)
assets-ref/

# imagens de revisão (local, servidas para o José)
_review/

# TTS ONNX models downloaded for research: 484 MB in 1,091 files, voices and the sherpa wasm. DOWNLOADED artefacts, not source:
# reproducible from their URL, heavy, and once inside git history they never leave.
docs/research/sherpa-wasm/

# 🔴 A RECORDED VOICE IS PERSONAL DATA, AND A COMMIT IS PUBLIC AND PERMANENT. The Dev records himself so the reading and the
# command tests have real speech to measure (`research/`, ADR-0191); the files are read where they sit and never tracked.
# ⚠️ Written on 2026-09-21 after a `git add -A` staged all six of them into a commit about something else and nothing objected.
# `tests/no-voice-in-the-tree.node.test.js` is the second brake, for the `add -f`, the rename and the extension this list misses.
research/*.m4a
research/*.wav
research/*.mp3
research/*.ogg

# Vitest browser-mode artefatos (gerados por rodada, nao versionados)
.vitest-attachments/
tests/__screenshots__/

# Python bytecode dos scripts de manutencao (scripts/*.py)
__pycache__/
*.pyc

# the machine's own answer to «where do the heavy files come from» (.env.example is the versioned one)
.env
