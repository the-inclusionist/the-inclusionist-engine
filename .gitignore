# Verification / dev artefacts (not source)
shots/
.playwright-mcp/
*.log
server.log
incl.js

# Dependencies / build
node_modules/
dist/
# the PACKAGE build's output (`npm run build:pkg`, tsconfig.pkg.json) — what `exports` points at and what
# `npm publish` ships. Generated, never versioned, for the same reason as `dist/`.
dist-pkg/
# the CARTRIDGE build's output (`vite build --mode cartridge`, ADR-0253) — the fixture game under tests/fixtures/game-build builds one
dist-lib/
.vite/
*.tsbuildinfo

# Operating system
.DS_Store
Thumbs.db

# PixelLab references (design only; licence != GPL — never embedded in the game)
assets-ref/

# review images (local, served to the Dev)
_review/

# TTS ONNX models downloaded for research: 484 MB in 1,091 files, voices and the sherpa wasm. DOWNLOADED artefacts, not source:
# reproducible from their URL, heavy, and once inside git history they never leave.
docs/research/sherpa-wasm/

# 🔴 A RECORDED VOICE IS PERSONAL DATA, AND A COMMIT IS PUBLIC AND PERMANENT. The Dev records himself so the reading and the
# command tests have real speech to measure (`research/`, ADR-0191); the files are read where they sit and never tracked.
# ⚠️ Written on 2026-09-21 after a `git add -A` staged all six of them into a commit about something else and nothing objected.
# `tests/no-voice-in-the-tree.node.test.js` is the second brake, for the `add -f`, the rename and the extension this list misses.
research/*.m4a
research/*.wav
research/*.mp3
research/*.ogg

# Vitest browser-mode artefacts (generated per run, not versioned)
.vitest-attachments/
tests/__screenshots__/

# Python bytecode of the maintenance scripts (scripts/*.py)
__pycache__/
*.pyc

# the machine's own answer to «where do the heavy files come from» (.env.example is the versioned one)
.env

# the Libras glosser's uv environment, if someone syncs it in place: it belongs outside the repository
# (INCLUSIONIST_LIBRAS_ENV, scripts/libras-glosses.mjs)
scripts/libras-glosses/.venv/

# the working copies of subagents: each is a branch of this repository, never content of it
.claude/worktrees/
